# GEMINI_API_KEY: Required for Gemini AI API calls in Google AI Studio.
# The platform injects this automatically from your project secrets.
GEMINI_API_KEY=

# Experimental Studio integrations remain disabled by default.
STUDIO_INTEGRATION_CANARY=false
STUDIO_IMAGE_ANIMATION=false
STUDIO_LUADRAW=false
STUDIO_DEPTH_2_5D=false
STUDIO_BLENDER=false
STUDIO_GENERATIVE_MOTION=false
LUADRAW_ENABLED=false
LUADRAW_NET_ENABLED=false
LUADRAW_3D_ENABLED=false
LUADRAW_AUTO_ROUTE=false
# External, immutable KNTT Mathematics reference corpus (local development default shown).
NA_MATH_NLS_SOURCE_ROOT=D:\NA-MATH-NLS-AI-SOURCES
