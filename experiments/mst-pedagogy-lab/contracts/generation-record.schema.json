{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mst-math.local/contracts/generation-record.schema.json",
  "title": "MST GenerationRecord V1 Experimental",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authority", "candidateQuestionId", "derivedFrom", "transformation", "generator", "validation", "teacherDecision"],
  "properties": {
    "schemaVersion": { "const": "generation-record.v1-exp" },
    "authority": { "const": "CANDIDATE_ONLY" },
    "candidateQuestionId": { "type": "string", "minLength": 1 },
    "derivedFrom": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "transformation": {
      "enum": [
        "PARAMETER_VARIATION",
        "CONTEXT_VARIATION",
        "REPRESENTATION_SWITCH",
        "REVERSE_PROBLEM",
        "ERROR_ANALYSIS",
        "MISSING_DATA",
        "REDUNDANT_DATA",
        "COUNTEREXAMPLE",
        "GENERALIZATION",
        "MULTI_SOLUTION",
        "STRATEGY_COMPARE",
        "MODELING",
        "OPEN_INVESTIGATION"
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "promptVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "promptVersion": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["math", "pedagogy", "curriculum"],
      "properties": {
        "math": { "$ref": "#/$defs/gateState" },
        "pedagogy": { "$ref": "#/$defs/gateState" },
        "curriculum": { "$ref": "#/$defs/gateState" }
      }
    },
    "teacherDecision": { "$ref": "#/$defs/gateState" }
  },
  "$defs": {
    "gateState": {
      "enum": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED", "REVIEW_REQUIRED"]
    }
  }
}
