  "semanticBoundaries": {
    "REASONING_vs_PROOF_JUSTIFICATION": "REASONING analyzes and infers; PROOF_JUSTIFICATION establishes a sufficiently grounded argument to prove or justify a conclusion.",
    "METHOD_PROCEDURE_vs_PROBLEM_SOLVING": "METHOD_PROCEDURE is a known reusable process; PROBLEM_SOLVING selects or creates a strategy when the path is not predetermined.",
    "APPLICATION_vs_REAL_WORLD_MATH_vs_MATHEMATICAL_MODELING": "APPLICATION transfers knowledge to a new task; REAL_WORLD_MATH provides authentic context; MATHEMATICAL_MODELING builds, solves, interprets, and validates a mathematical model against reality.",
    "SYNTHESIS_vs_IMPORTANT": "SYNTHESIS systematizes learned knowledge; IMPORTANT signals emphasis.",
    "PRIOR_KNOWLEDGE_vs_CONCEPT": "PRIOR_KNOWLEDGE activates prerequisites; CONCEPT represents knowledge being learned.",
    "EXPLORE_vs_ACTIVITY": "EXPLORE investigates, tests, detects patterns or makes conjectures; ACTIVITY is the general learning-task container.",
    "PROBLEM_SOLVING_vs_SOLUTION": "PROBLEM_SOLVING is the search for a pathway; SOLUTION is the completed solution representation."
  },
