  "supersedes": "PIMATH-DNA-SEMANTIC-ICONS-V1.0",
  "inherits": "PIMATH-DNA-SEMANTIC-ICONS-V1.0",
  "machineIdPolicy": "PRESERVE_PIMATH_CANONICAL_IDS_DURING_MST_MATH_BRAND_MIGRATION",
  "principle": "AUTHOR_ONCE_RENDER_MANY_SAME_ICON_SEMANTICS",
  "style": {
    "family": "MINIMAL_ACADEMIC_LINE",
    "masterFormat": "SVG",
    "viewBox": "0 0 24 24",
    "strokeWidth": 1.55,
    "strokeLinecap": "round",
    "strokeLinejoin": "round",
    "decorative": false,
    "filledDefault": false,
    "monochromeSafe": true,
    "noOwnColorPalette": true,
    "noGradient": true,
    "noEmoji": true,
    "no3d": true
  },
  "colorPolicy": "INHERIT_SEMANTIC_CONTEXT",
  "fallbackPolicy": "FAIL_CLOSED",
  "outputContract": {
    "identityRule": "SAME_SEMANTIC_ROLE_SAME_MASTER_ASSET",
    "targets": {
      "PDF": {
        "adapter": "SVG_TO_VECTOR_PDF",
        "preserveIdentity": true,
        "fallback": "PNG_DERIVED_FROM_CANONICAL_SVG_ONLY"
      },
      "DOCX": {
        "adapter": "EMBED_SVG",
        "preserveIdentity": true,
        "fallback": "PNG_DERIVED_FROM_CANONICAL_SVG_ONLY"
      },
      "HTML": {
        "adapter": "INLINE_OR_IMG_SVG",
        "preserveIdentity": true,
        "fallback": "NONE"
      },
      "SLIDES": {
        "adapter": "SVG_VECTOR",
        "preserveIdentity": true,
        "fallback": "PNG_DERIVED_FROM_CANONICAL_SVG_ONLY"
      },
      "VIDEO": {
        "adapter": "SVG_VECTOR_MOTION_WRAPPER",
        "preserveIdentity": true,
        "fallback": "RASTER_DERIVED_FROM_CANONICAL_SVG_ONLY",
        "motion": {
          "identityMayChange": false,
          "allowed": ["fade", "scale_0_96_to_1", "short_slide"],
          "forbidden": ["spin", "bounce", "morph_to_other_icon", "decorative_loop"],
          "maxIntroMs": 320
        }
      }
    }
  },
