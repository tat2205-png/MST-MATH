{
  "name": "react-example",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "tsx -r dotenv/config server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "studio": "pwsh -ExecutionPolicy Bypass -File .\\scripts\\start-studio.ps1",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','server.js'])fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "qa:quick": "pwsh -ExecutionPolicy Bypass -File .\\scripts\\dev-loop.ps1 -Mode Quick",
    "qa:full": "pwsh -ExecutionPolicy Bypass -File .\\scripts\\dev-loop.ps1 -Mode Full",
    "qa:repair": "pwsh -ExecutionPolicy Bypass -File .\\scripts\\dev-loop.ps1 -Mode RepairSmoke",
    "qa:math": "npx tsx tests/math-regression.ts",
    "python:sync": "uv sync --group test",
    "qa:python-runtime": "uv run --group test python scripts/doctor_python_runtime.py",
    "qa:python-math": "uv run --group test python -m pytest tests/test_python_math_stack.py -q",
    "qa:manim": "uv run --group test python -m pytest tests/test_manim_toolkit.py tests/test_manim_toolkit_golden_scene.py tests/test_manim_toolkit_hardening.py tests/test_manim_toolkit_phase2b_baseline.py -q",
    "qa:na-math-v2.6": "node --import tsx tests/test-na-math-v2.6.ts",
    "qa:docx:1a": "node --import tsx tests/test-docx-1a.ts",
    "qa:docx:1b": "node --import tsx tests/test-docx-1b.ts",
    "qa:docx:1c": "node --import tsx tests/test-docx-1c.ts",
    "qa:docx:1d": "node --import tsx tests/test-docx-1d.ts",
    "qa:docx:1e": "node --import tsx tests/test-docx-1e.ts",
    "qa:docx:1f": "node --import tsx tests/test-docx-1f.ts",
    "qa:docx": "npm run qa:docx:1a && npm run qa:docx:1b && npm run qa:docx:1c && npm run qa:docx:1d && npm run qa:docx:1e && npm run qa:docx:1f && npm run qa:na-math-v2.6",
    "golden:docx": "node --import tsx scripts/generate-docx-goldens.ts",
    "qa:luadraw": "python scripts/doctor_luadraw.py && node --import tsx tests/test-luadraw-contract.ts",
    "qa:luadraw:smoke": "node --import tsx scripts/run-luadraw-smoke.ts",
    "bridge:start": "python local_bridge/bridge.py",
    "qa:regression": "node scripts/run-regression.mjs",
    "qa:question-bank": "node --import tsx tests/test-question-bank-qb1a.ts && node --import tsx tests/test-question-bank-qb1b.ts && node --import tsx tests/test-question-bank-qb1c.ts",
    "qa:question-bank:persistence": "node --import tsx tests/test-question-bank-qb1d.ts",
    "qa:question-bank:e2e": "node --import tsx tests/test-question-bank-qb1e.ts",
    "qa:question-bank:search": "node --import tsx tests/test-question-bank-qb1f.ts",
    "qa:assessment": "node --import tsx tests/test-question-bank-qb2a.ts",
    "qa:game": "node --import tsx tests/test-question-bank-qb2b.ts",
    "qa:question-video": "node --import tsx tests/test-question-bank-qb2c.ts",
    "qa:question-video:runtime": "node --import tsx scripts/run-question-video-runtime.ts",
    "qa:export": "node --import tsx tests/test-question-bank-qb2d.ts",
    "qa:ux-01": "node --import tsx tests/test-teacher-workflow-ux01.ts",
    "nls:sources:register": "node --import tsx scripts/register-nls-sources.ts",
    "qa:nls:sources": "node --import tsx tests/test-nls-source-registry.ts",
    "nls:structure:discover": "node --import tsx scripts/discover-nls-structure.ts",
    "qa:nls:structure": "node --import tsx tests/test-nls-structure.ts",
    "qa:nls:structure-review": "node --import tsx tests/test-nls-structure-review.ts",
    "arch:check": "depcruise src server server.ts --config .dependency-cruiser.cjs --output-type err-long",
    "arch:report": "depcruise src server server.ts --config .dependency-cruiser.cjs --output-type text",
    "release:gate": "npm run arch:check && pwsh -ExecutionPolicy Bypass -File .\\scripts\\release-gate.ps1",
    "project:status": "node scripts/project-status.mjs",
    "ia:status": "tsx image-animation/automation/scripts/status.ts",
    "ia:qa": "tsx image-animation/automation/scripts/qa.ts",
    "ia:regression": "tsx image-animation/automation/scripts/regression.ts",
    "ia:test-agent": "tsx image-animation/tests/agent-sandbox.test.ts",
    "ia:agent-status": "tsx image-animation/automation/scripts/agent-status.ts",
    "ia:build": "tsx image-animation/automation/scripts/build.ts",
    "ia:doctor": "tsx image-animation/automation/scripts/doctor.ts",
    "ia:resume": "tsx image-animation/automation/scripts/resume.ts",
    "ia:task-test": "tsx image-animation/automation/scripts/task-test.ts",
    "ia:self-build": "tsx image-animation/automation/scripts/self-build.ts",
    "ia:auto": "tsx image-animation/automation/scripts/auto.ts",
    "ia:test-repair": "tsx image-animation/tests/repair-loop.test.ts",
    "qa:ci": "npm run arch:check && npm run lint && npm run build && npm run qa:regression"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.0",
    "fflate": "^0.8.3",
    "katex": "^0.18.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
