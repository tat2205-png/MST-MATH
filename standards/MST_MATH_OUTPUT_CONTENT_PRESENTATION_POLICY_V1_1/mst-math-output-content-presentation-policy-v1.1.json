{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "MST_MATH_OUTPUT_CONTENT_PRESENTATION_POLICY_V1.1",
  "version": "1.1.0",
  "status": "LOCKED_CANONICAL_APPROVED",
  "canonical": true,
  "approved": true,
  "humanApproved": true,
  "root": "MST-MATH-DNA-V1.0",
  "inherits": "MST_MATH_OUTPUT_CONTENT_PRESENTATION_POLICY_V1.0",
  "supersedes": "MST_MATH_OUTPUT_CONTENT_PRESENTATION_POLICY_V1.0",
  "scope": "OUTPUT_CONTENT_PRESENTATION_PEDAGOGICAL_REFLOW_STUDENT_WORKSPACE_AND_PRE_EXPORT_QA",
  "sourceDecision": "Human product owner directive 2026-09-05",
  "principles": [
    "CONTENT_FIRST_NO_PROMOTIONAL_BRANDING",
    "A4_FOR_ALL_DOCUMENT_ARTIFACTS_EXCEPT_VIDEO",
    "QUESTION_AND_ANSWER_BLOCK_INTEGRITY",
    "FIGURE_CLARITY_AND_PAGE_BALANCE",
    "PEDAGOGICAL_FLOW_BEFORE_PAGE_COMPACTION",
    "MEANINGLESS_WHITESPACE_MAY_BE_REDUCED",
    "STUDENT_WRITING_SPACE_IS_MEANINGFUL_AND_MUST_BE_PRESERVED",
    "RULED_NOTE_SPACE_ALWAYS_PRESENT_FOR_P01_AND_P03",
    "PAGE_NUMBER_ALWAYS_VISIBLE_AT_BOTTOM_OF_EVERY_A4_PAGE",
    "FINAL_ANSWER_SECTION_REQUIRED",
    "ANSWER_QA_BEFORE_EXPORT",
    "FAIL_CLOSED_ON_UNVERIFIED_ANSWER"
  ],
  "document": {
    "page": {
      "size": "A4",
      "required": true,
      "appliesTo": [
        "P01_LEARNING_MATERIAL",
        "P02_LESSON_PLAN",
        "P03_WORKSHEET",
        "P04_EXERCISE_SHEET",
        "P05_TEST",
        "P06_EXAM_SCHOOL",
        "P06_EXAM_THPTQG",
        "P06_EXAM_DGNL",
        "P06_EXAM_VSAT",
        "P06_EXAM_SAT_PRINT"
      ],
      "exceptions": ["P07_VIDEO", "INTERACTIVE_ONLY_SURFACES"]
    },
    "pageNumber": {
      "required": true,
      "appliesToEveryA4Page": true,
      "position": "BOTTOM_CENTER",
      "format": "ARABIC_INTEGER_ONLY",
      "firstPageVisible": true,
      "answerPagesIncluded": true,
      "footerContentOtherThanPageNumber": "FORBIDDEN_UNLESS_PEDAGOGICALLY_REQUIRED_BY_OUTPUT_PROFILE",
      "mustNotActAsBranding": true,
      "mustNotCollideWithContentOrTrim": true
    },
    "branding": {
      "showMstMathBrand": false,
      "showProductDescriptor": false,
      "showLogo": false,
      "showWatermark": false,
      "showPromotionalFooter": false,
      "showMarketingTagline": false,
      "allowedVisibleIdentity": "LEARNING_CONTENT_ONLY"
    },
    "visibleTextPolicy": {
      "allowed": [
        "LEARNING_CONTENT_TITLE",
        "LEARNING_CONTENT_BODY",
        "QUESTION_TEXT",
        "ANSWER_OPTIONS",
        "TABLE_DATA",
        "FIGURE_LABELS_WHEN_MATHEMATICALLY_REQUIRED",
        "ANSWER_SECTION",
        "PAGE_NUMBER",
        "SEMANTIC_ICON_ASSOCIATED_WITH_CONTENT_ROLE"
      ],
      "forbidden": [
        "MST_MATH_PROMOTION",
        "PRODUCT_PROMOTION",
        "MARKETING_SLOGAN",
        "DECORATIVE_BRAND_CAPTION",
        "NON_PEDAGOGICAL_ANNOTATION"
      ]
    },
    "answerSection": {
      "required": true,
      "placement": "END_OF_DOCUMENT",
      "coversAllQuestionsRequiringAnswers": true,
      "mcqAnswerFormat": "CLEAR_COMPACT_UNAMBIGUOUS",
      "trueFalseAnswerFormat": "CLEAR_PER_STATEMENT",
      "shortAnswerFormat": "FINAL_VALUE_OR_REQUIRED_EXPRESSION",
      "essayAnswerPolicy": "FINAL_ANSWER_OR_KEY_RESULT_AS_PROFILE_REQUIRES",
      "solutionVisibility": "OUTPUT_PROFILE_CONTROLLED"
    }
  },
  "pedagogicalReflow": {
    "enabled": true,
    "appliesTo": [
      "P01_LEARNING_MATERIAL",
      "P03_WORKSHEET",
      "P07_VIDEO",
      "P11_DIGITAL_AI_LESSON"
    ],
    "purpose": "Reduce meaningless page or scene whitespace without breaking learning progression, mathematical dependencies, source fidelity, or student writing space.",
    "priorityOrder": [
      "PEDAGOGICAL_FLOW",
      "MATHEMATICAL_DEPENDENCY",
      "QUESTION_FIGURE_AND_OPTION_INTEGRITY",
      "STUDENT_WRITING_SPACE",
      "READABILITY",
      "PAGE_OR_SCENE_UTILIZATION"
    ],
    "allowed": {
      "reorderQuestionsWithinSamePedagogicalCluster": true,
      "reorderIndependentQuestionsWithEquivalentLearningRole": true,
      "moveWholeQuestionBlockToFillSafePageSpace": true,
      "regenerateDisplayQuestionNumberAfterApprovedReorder": true,
      "preserveStableSourceIdAndProvenance": true
    },
    "mustPreserve": [
      "PREREQUISITE_BEFORE_DEPENDENT_TASK",
      "CONCEPT_BEFORE_FIRST_REQUIRED_APPLICATION",
      "SCAFFOLDING_FROM_SUPPORTED_TO_INDEPENDENT_WHERE_INTENDED",
      "INTENDED_DIFFICULTY_PROGRESSION",
      "SHARED_STEM_AND_SUBQUESTION_GROUP",
      "QUESTION_AND_ITS_FIGURE",
      "QUESTION_AND_ITS_ANSWER_OPTIONS",
      "SCENARIO_CONTINUITY",
      "REFERENCES_TO_PREVIOUS_RESULT",
      "ACTIVITY_PHASE_ORDER_WHEN_PEDAGOGICALLY_DEFINED",
      "SOURCE_IDENTITY_AND_PROVENANCE"
    ],
    "forbidden": [
      "REORDER_ACROSS_DEPENDENCY_EDGE",
      "REORDER_THAT_REVEALS_ANSWER_OR_METHOD_TOO_EARLY",
      "REORDER_THAT_BREAKS_DISCOVERY_TO_FORMALIZATION_FLOW",
      "REORDER_THAT_BREAKS_WARMUP_TO_CONCEPT_TO_PRACTICE_TO_APPLICATION_FLOW",
      "REORDER_ONLY_TO_MAXIMIZE_DENSITY_WHEN_PEDAGOGY_DEGRADES",
      "MOVE_SUBQUESTION_AWAY_FROM_SHARED_STEM",
      "DELETE_OR_COMPRESS_STUDENT_WRITING_SPACE_AS_WHITESPACE"
    ],
    "whitespaceSemantics": {
      "meaninglessWhitespaceMayBeReduced": true,
      "studentWorkspaceIsMeaningfulWhitespace": true,
      "pedagogicalPauseSpaceMayBeMeaningful": true,
      "figureClearanceIsMeaningful": true,
      "sectionSeparationIsMeaningful": true
    },
    "traceability": {
      "recordOriginalOrder": true,
      "recordRenderedOrder": true,
      "recordReasonForReorder": true,
      "requireDependencyCheckBeforeReorder": true
    }
  },
  "studentWorkspace": {
    "requiredProfiles": ["P01_LEARNING_MATERIAL", "P03_WORKSHEET"],
    "requiredForEveryQuestion": true,
    "includesMultipleChoice": true,
    "purpose": "Provide just-enough ruled space for student notes, scratch work, reasoning, calculations, or annotations related to the nearby question.",
    "ruledLineStyle": {
      "studentNotebookLike": true,
      "linePitchMm": 7.0,
      "linePitchToleranceMm": 0.5,
      "strokePt": 0.35,
      "tone": "SUBTLE_LINE_CORE_TOKEN_OR_GRAYSCALE_EQUIVALENT",
      "printSafe": true,
      "noDecorativeGrid": true,
      "noLongTextLabel": true,
      "semanticIconMarkerOnlyWhenNeeded": true
    },
    "adaptiveCapacity": {
      "policy": "JUST_ENOUGH_BASED_ON_EXPECTED_STUDENT_WORK_NOT_SOLUTION_LENGTH",
      "minimumRuledRows": {
        "MULTIPLE_CHOICE": 2,
        "TRUE_FALSE": 3,
        "SHORT_ANSWER": 4,
        "CONSTRUCTED_RESPONSE": 6,
        "OPEN_INVESTIGATION": 8
      },
      "mayIncreaseRowsFor": [
        "MULTI_STEP_CALCULATION",
        "GEOMETRIC_REASONING",
        "GRAPH_OR_TABLE_ANALYSIS",
        "REAL_WORLD_MODELING",
        "JUSTIFICATION_REQUIRED"
      ],
      "mayNotReduceBelowMinimumToFillPage": true,
      "mayNotUseAnswerSolutionLengthAsDirectWorkspaceProxy": true,
      "mustRemainAdjacentToOrClearlyOwnedByQuestion": true
    },
    "figureInteraction": {
      "noFigureWorkspaceOverlap": true,
      "whenQuestionHasFigure": "KEEP_FIGURE_AND_RULED_WORKSPACE_IN_SAME_QUESTION_OWNERSHIP_REGION",
      "preferredCompositionWhenSuitable": "RULED_WORKSPACE_LEFT_FIGURE_RIGHT",
      "figureReadabilityHasPriorityOverCosmeticSymmetry": true
    }
  },
  "figure": {
    "appliesToMathFigures": true,
    "questionContainment": {
      "required": true,
      "rule": "A figure belonging to a question must remain wholly inside the visual ownership region of that question and its answer/options block; it must not drift into the next question or unrelated content.",
      "keepWithQuestion": true,
      "keepWithOptionsWhenOptionsDependOnFigure": true,
      "splitAcrossPages": false
    },
    "pageBalance": {
      "required": true,
      "preserveAspectRatio": true,
      "noDistortion": true,
      "noCropOfMathematicalContent": true,
      "noOverlapText": true,
      "noOverlapAnswerOptions": true,
      "noOverlapStudentWorkspace": true,
      "noOverlapPageMargin": true,
      "avoidOrphanFigure": true,
      "avoidExcessiveEmptySpaceCausedByFigure": true,
      "preferMoveWholeQuestionToNextPageBeforeUnsafeShrink": true,
      "mayUsePedagogicallySafeQuestionReorderBeforeLeavingMeaninglessWhitespace": true
    },
    "clarity": {
      "required": true,
      "vectorPreferred": true,
      "rasterMinimumEffectiveDpiForPrint": 300,
      "textAndLabelsReadableAtFinalA4Size": true,
      "thinLinesMustSurvivePrint": true,
      "grayscaleSafeWhereRequired": true,
      "noBlur": true,
      "noPixelation": true,
      "noCompressionArtifactThatChangesMeaning": true
    },
    "semanticIntegrity": {
      "geometryZeroInference": true,
      "doNotInventMissingRelations": true,
      "doNotDecorativelyAlterMathematicalFigure": true,
      "preserveLabelsAndDependencies": true
    }
  },
  "video": {
    "pageSize": "NOT_APPLICABLE",
    "branding": {
      "showMstMathBrand": false,
      "showProductDescriptor": false,
      "showLogo": false,
      "showWatermark": false,
      "showPromotionalIntroOutro": false,
      "showMarketingTagline": false
    },
    "visibleOverlayPolicy": {
      "allowed": [
        "LEARNING_CONTENT_TITLE",
        "LEARNING_CONTENT_BODY",
        "MATHEMATICAL_NOTATION",
        "PEDAGOGICALLY_REQUIRED_FIGURE_LABELS",
        "SEMANTIC_ICON_ASSOCIATED_WITH_CONTENT_ROLE"
      ],
      "forbidden": [
        "PROMOTIONAL_BRAND_OVERLAY",
        "DECORATIVE_BRAND_BADGE",
        "NON_PEDAGOGICAL_CAPTION"
      ]
    },
    "reflow": {
      "pedagogicallySafeQuestionOrExampleReorderAllowed": true,
      "sceneOrderMustPreserveLearningDependency": true,
      "doNotReorderToCreatePrematureMethodReveal": true,
      "doNotUseBlankSceneSpaceAsReasonToBreakOneFocusPerScene": true
    }
  },
  "answerQa": {
    "requiredBeforeExport": true,
    "appliesTo": "ALL_DOCUMENT_OUTPUTS_WITH_ANSWERS",
    "automatedExportAllowedOnlyIf": "ANSWER_QA_PASS",
    "dimensions": [
      "SOURCE_FIDELITY",
      "MATHEMATICAL_CORRECTNESS",
      "LOGICAL_VALIDITY",
      "DOMAIN_AND_BOUNDARY_CORRECTNESS",
      "NUMERIC_CORRECTNESS",
      "UNITS_AND_DIMENSIONS",
      "GEOMETRY_INVARIANTS",
      "ANSWER_TO_QUESTION_ALIGNMENT",
      "OPTION_KEY_ALIGNMENT",
      "TRUE_FALSE_STATEMENT_ALIGNMENT",
      "PEDAGOGICAL_APPROPRIATENESS",
      "CURRICULUM_APPROPRIATENESS",
      "REAL_WORLD_ASSUMPTION_PLAUSIBILITY_WHEN_APPLICABLE",
      "REAL_WORLD_RESULT_PLAUSIBILITY_WHEN_APPLICABLE"
    ],
    "mcq": {
      "verifyExactlyOneCorrectOptionWhenProfileRequiresSingleChoice": true,
      "verifyAnswerKeyMatchesComputedOrProvenResult": true,
      "verifyDistractorsDoNotCreateMultipleCorrectAnswers": true,
      "verifyNoOptionLabelMismatch": true
    },
    "trueFalse": {
      "verifyEachStatementIndependently": true,
      "verifyNoCrossStatementInferenceError": true
    },
    "shortAnswer": {
      "verifyNormalizationAndAcceptedEquivalentForms": true,
      "verifyRoundingAndUnitsWhenSpecified": true
    },
    "failurePolicy": {
      "onFail": "BLOCK_EXPORT",
      "onNeedMoreInformation": "BLOCK_EXPORT",
      "onWarningAffectingCorrectness": "BLOCK_EXPORT",
      "onPurelyCosmeticWarning": "ALLOW_ONLY_IF_LAYOUT_QA_PASSES"
    }
  },
  "preExportGates": [
    "A4_PAGE_POLICY_PASS",
    "PAGE_NUMBER_BOTTOM_EVERY_PAGE_PASS",
    "NO_PROMOTIONAL_BRANDING_PASS",
    "VISIBLE_CONTENT_ONLY_PASS",
    "PEDAGOGICAL_REFLOW_DEPENDENCY_PASS",
    "NO_MEANINGFUL_WORKSPACE_REMOVED_PASS",
    "P01_P03_RULED_WORKSPACE_PASS",
    "STUDENT_NOTE_LINE_PITCH_PASS",
    "FIGURE_QUESTION_CONTAINMENT_PASS",
    "FIGURE_CLARITY_PASS",
    "FIGURE_PAGE_BALANCE_PASS",
    "NO_FIGURE_SPLIT_PASS",
    "ANSWER_SECTION_AT_END_PASS",
    "ANSWER_COVERAGE_PASS",
    "ANSWER_QA_PASS",
    "MATH_QA_PASS",
    "PEDAGOGY_QA_PASS",
    "OUTPUT_PROFILE_QA_PASS"
  ],
  "governance": {
    "rendererMayAddBranding": false,
    "rendererMayMoveFigureOutsideQuestionOwnership": false,
    "rendererMayShrinkFigureUntilLabelsUnreadable": false,
    "rendererMayExportUnverifiedAnswer": false,
    "rendererMayDeleteStudentWorkspaceToImproveDensity": false,
    "rendererMayReorderWithoutDependencyCheck": false,
    "rendererMayOmitPageNumber": false,
    "failClosed": true
  }
}
