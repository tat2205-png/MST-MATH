{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://na-math.local/schemas/semantic-geometry-scene-v1.1.json",
  "title": "NA Math Semantic Geometry Scene V1.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "layoutContract",
    "objects",
    "relations",
    "activeViewProfileId",
    "availableViewProfiles",
    "verificationStatus",
    "renderPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "layoutContract": {
      "type": "object",
      "required": [
        "layoutId",
        "layoutStatus",
        "geometryMayChangeLayout"
      ],
      "properties": {
        "layoutId": {
          "const": "NA-MATH-LAYOUT-V1.3-CANONICAL"
        },
        "layoutStatus": {
          "const": "LOCKED"
        },
        "geometryMayChangeLayout": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "point",
              "line",
              "segment",
              "ray",
              "plane",
              "face",
              "polygon",
              "circle",
              "solid",
              "marker"
            ]
          },
          "label": {
            "type": "string"
          },
          "provenance": {
            "enum": [
              "GIVEN",
              "CONSTRUCTED",
              "DERIVED",
              "CONFIRMED"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "objects",
          "provenance",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "parallel",
              "perpendicular",
              "incidence",
              "intersection",
              "disjoint",
              "coplanar",
              "noncoplanar",
              "skew",
              "equal-length",
              "equal-angle",
              "midpoint",
              "projection-foot",
              "altitude",
              "circumcenter",
              "incenter",
              "centroid",
              "cyclic",
              "contains",
              "lies-in",
              "same-direction-family"
            ]
          },
          "objects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "enum": [
              "GIVEN",
              "CONSTRUCTED",
              "DERIVED",
              "CONFIRMED"
            ]
          },
          "status": {
            "enum": [
              "UNPROVEN",
              "PARTIAL",
              "VERIFIED",
              "REJECTED"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "activeViewProfileId": {
      "type": "string",
      "minLength": 1
    },
    "availableViewProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "projection",
          "edgeStyles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "projection": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "parallel"
              }
            },
            "additionalProperties": true
          },
          "edgeStyles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "edgeId",
                "style",
                "source"
              ],
              "properties": {
                "edgeId": {
                  "type": "string"
                },
                "style": {
                  "enum": [
                    "solid",
                    "dashed"
                  ]
                },
                "source": {
                  "const": "VIEW_PROFILE"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "verificationStatus": {
      "enum": [
        "UNPROVEN",
        "PARTIAL",
        "VERIFIED",
        "REJECTED"
      ]
    },
    "renderPolicy": {
      "type": "object",
      "required": [
        "noVisualInference",
        "failClosed",
        "allowUnverifiedDecorativeGeometry"
      ],
      "properties": {
        "noVisualInference": {
          "const": true
        },
        "failClosed": {
          "const": true
        },
        "allowUnverifiedDecorativeGeometry": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}